{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Almanac work v1",
  "description": "Модель главы. Дополнительные проверки путей, ссылок, диапазонов и конечных координат выполняет tools/build.py.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "subtitle": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "year": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 3000
    },
    "status": {
      "enum": [
        "demo",
        "draft",
        "reviewed"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "cover": {
      "oneOf": [
        {
          "const": ""
        },
        {
          "type": "string",
          "pattern": "^content/assets/[^?#\\\\]+$"
        }
      ]
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "paragraphs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "formula": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "title",
          "paragraphs"
        ]
      },
      "minItems": 1
    },
    "figures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "pattern": "^content/assets/[^?#\\\\]+$"
          },
          "caption": {
            "type": "string",
            "minLength": 1
          },
          "alt": {
            "type": "string",
            "minLength": 1
          },
          "provenance": {
            "enum": [
              "demo",
              "original",
              "derived",
              "reconstructed"
            ]
          }
        },
        "required": [
          "id",
          "title",
          "path",
          "caption",
          "alt",
          "provenance"
        ]
      },
      "minItems": 0
    },
    "charts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "xLabel": {
            "type": "string",
            "minLength": 1
          },
          "yLabel": {
            "type": "string",
            "minLength": 1
          },
          "series": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "values": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "number"
                      }
                    ],
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "minItems": 1
                }
              },
              "required": [
                "id",
                "name",
                "values"
              ]
            },
            "minItems": 1
          },
          "note": {
            "type": "string",
            "minLength": 1
          },
          "provenance": {
            "enum": [
              "demo",
              "original",
              "derived",
              "reconstructed"
            ]
          }
        },
        "required": [
          "id",
          "title",
          "xLabel",
          "yLabel",
          "series",
          "note",
          "provenance"
        ]
      },
      "minItems": 0
    },
    "code": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "language": {
            "enum": [
              "pascal",
              "javascript",
              "text"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^content/assets/[^?#\\\\]+$"
          },
          "note": {
            "type": "string",
            "minLength": 1
          },
          "highlights": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "start": {
                  "type": "integer",
                  "minimum": 1
                },
                "end": {
                  "type": "integer",
                  "minimum": 1
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "start",
                "end",
                "label"
              ]
            },
            "minItems": 0
          }
        },
        "required": [
          "id",
          "title",
          "language",
          "path",
          "note",
          "highlights"
        ]
      },
      "minItems": 0
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "pattern": "^content/assets/[^?#\\\\]+$"
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string",
            "minLength": 1
          },
          "provenance": {
            "enum": [
              "demo",
              "original",
              "derived",
              "reconstructed"
            ]
          }
        },
        "required": [
          "id",
          "title",
          "path",
          "type",
          "note",
          "provenance"
        ]
      },
      "minItems": 0
    },
    "experiment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "bch",
            "trains",
            "sensitivity",
            "none"
          ]
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "note"
      ]
    },
    "methodNotes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "title",
    "subtitle",
    "kind",
    "year",
    "status",
    "summary",
    "tags",
    "cover",
    "sections",
    "figures",
    "charts",
    "code",
    "sources",
    "experiment",
    "methodNotes"
  ]
}
